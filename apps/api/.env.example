# Optional: queue mode. Copy to .env for local development. Never commit real secrets.
DATABASE_URL="postgresql://debugany:debugany_local_only@localhost:5432/debugany?schema=public"
PORT=4000
NODE_ENV=development
REDIS_URL="redis://localhost:6379"

# Required only for webhook secrets (openssl rand -base64 32).
# DEBUGANY_ENCRYPTION_KEY="replace-with-a-generated-32-byte-base64-key"

# Set true on the worker process; consumes the events and delivery queues.
# DEBUGANY_WORKER=true
# Set true on API processes to enqueue events instead of persisting inline.
# DEBUGANY_INGESTION_MODE_QUEUE=true

# Rate limiter storage: memory (default, single-instance) or redis (shared
# across API instances; requires REDIS_URL; auth fails closed with 503 if Redis
# is unavailable).
# DEBUGANY_RATE_LIMIT_STORAGE=redis
