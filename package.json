{
  "name": "debugany",
  "version": "0.1.0",
  "private": true,
  "description": "Application observability, error tracking, and debugging platform",
  "license": "UNLICENSED",
  "engines": { "node": ">=20" },
  "workspaces": ["apps/api"],
  "scripts": {
    "dev:api": "npm run dev --workspace @debugany/api",
    "build:api": "npm run build --workspace @debugany/api",
    "typecheck": "npm run typecheck --workspace @debugany/api",
    "db:generate": "npm run prisma:generate --workspace @debugany/api",
    "db:migrate": "npm run prisma:migrate --workspace @debugany/api",
    "db:seed": "npm run prisma:seed --workspace @debugany/api",
    "check:repo": "node -e \"console.log('Debugany workspace metadata is valid.')\""
  }
}